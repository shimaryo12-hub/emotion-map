rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /emotions/{photoId} {
      allow read: if true;
      allow create: if request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow update, delete: if false;
    }
  }
}
